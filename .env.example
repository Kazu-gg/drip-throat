# Copy to .env.local and fill in values. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=https://www.chevelle.in

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay public key only — secret stays in Supabase Edge Functions
NEXT_PUBLIC_RAZORPAY_KEY_ID=

NEXT_PUBLIC_CHEVELLE_STORE_ID=

NEXT_PUBLIC_AUTH_ENABLED=true

# Optional — platform fee per cart item (INR, default 49)
# NEXT_PUBLIC_PLATFORM_FEE_PER_ITEM=49
