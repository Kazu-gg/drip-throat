# Copy to .env.local and fill in values. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set true to force static catalog even if Supabase keys exist
NEXT_PUBLIC_USE_MOCK=true

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Leave blank for mock mode (uses static products from src/lib/products.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay public key only — secret stays in Supabase Edge Functions
NEXT_PUBLIC_RAZORPAY_KEY_ID=

NEXT_PUBLIC_CHEVELLE_STORE_ID=

# Keep false in mock mode (auth requires Supabase)
NEXT_PUBLIC_AUTH_ENABLED=false

# Optional — platform fee per cart item (INR, default 49) — legacy; cart now uses product prices
# NEXT_PUBLIC_PLATFORM_FEE_PER_ITEM=49

# Commerce / marketing (optional overrides)
# NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=499
# NEXT_PUBLIC_BUY_TWO_ENABLED=true
# NEXT_PUBLIC_BUY_TWO_TITLE=BUY 2 & SAVE
# NEXT_PUBLIC_BUY_TWO_SUBTITLE=2 TEES FOR ₹999
# NEXT_PUBLIC_BUY_TWO_PRICE=999
# NEXT_PUBLIC_BUY_TWO_QTY=2
# NEXT_PUBLIC_BUY_TWO_SLUGS=oversized-cotton-tee,essential-black-tee
# NEXT_PUBLIC_PROMO_POPUP_ENABLED=true
# NEXT_PUBLIC_PROMO_POPUP_TITLE=GET ₹100 OFF
# NEXT_PUBLIC_PROMO_POPUP_DESC=On orders above ₹999. Use code DRIP100 at checkout.
# NEXT_PUBLIC_PROMO_POPUP_DISCOUNT=100
# NEXT_PUBLIC_PROMO_POPUP_MIN=999
# NEXT_PUBLIC_PROMO_POPUP_DISMISS_DAYS=7
